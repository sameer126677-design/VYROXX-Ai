# ==============================================================================
# SERVER-ONLY SECRETS (Never expose to client bundle or VITE_* variables)
# ==============================================================================
# CODECRAFT_API_KEY: Server-side key for AI scene planning (/api/ai/plan-scene).
# AI Studio injects this at runtime from user Secrets.
CODECRAFT_API_KEY="MY_CODECRAFT_API_KEY"

# ==============================================================================
# SERVER RUNTIME & CORS CONFIGURATION
# ==============================================================================
# APP_URL: Canonical origin URL where this applet is hosted (used for CORS).
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Optional comma-separated list of additional trusted origins
# ALLOWED_ORIGINS="https://example.com,https://studio.example.com"

# NODE_ENV: "development" or "production" (controls CSP, HSTS, and static serving)
NODE_ENV="development"

# Note: Non-secret Firebase client configuration lives in firebase-applet-config.json
# and relies on Firebase Security Rules + verified JWT authentication for protection.
